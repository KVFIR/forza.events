# FORZA.EVENTS — single local env file
#
# Setup:
#   cp .env.example .env
#   fill the REQUIRED values below (6 keys from 2 consoles)
#   npm run dev                          # Activity
#   npm run sync:secrets                 # push server secrets to Supabase
#
# Canonical names only — no need to duplicate VITE_* and server vars.
# Vite maps DISCORD_CLIENT_ID / SUPABASE_* into the client bundle automatically.
#
# Mock mode: leave .env empty and open http://localhost:5180 in a browser.

# =============================================================================
# REQUIRED — Discord Developer Portal (one app)
# https://discord.com/developers/applications
# =============================================================================

# General Information → Application ID
DISCORD_CLIENT_ID=

# OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=

# General Information → Public Key (Interactions Endpoint verification)
DISCORD_PUBLIC_KEY=

# Bot → Token
DISCORD_BOT_TOKEN=

# =============================================================================
# REQUIRED — Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard
# =============================================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=

# =============================================================================
# OPTIONAL
# =============================================================================

# OAuth2 → Redirects (must match Discord portal if set)
# Embedded Activity auth often works without this; add only if token exchange fails.
# DISCORD_REDIRECT_URI=

# Default cover image origin in Discord embeds (defaults to https://forza.events)
# APP_ORIGIN=https://forza.events

# Local Edge Function testing only — auto-injected when functions run on Supabase
# SUPABASE_SERVICE_ROLE_KEY=

# Override Edge Functions base (default: ${SUPABASE_URL}/functions/v1)
# VITE_API_BASE_URL=

# =============================================================================
# Railway + Railpack (recommended Activity hosting)
# =============================================================================
# New Project → Deploy from GitHub → builder: Railpack (railway.toml).
# Set variables in Railway dashboard (needed at build time for Vite):
#   DISCORD_CLIENT_ID
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
# Public URL: https://<service>.up.railway.app
# Use it in Discord Activities URL Mapping + DISCORD_REDIRECT_URI + APP_ORIGIN.
# Do NOT set a custom start command — Railpack serves dist/ via Caddy (Staticfile).

# =============================================================================
# Discord portal (not env vars — configure once in Developer Portal)
# =============================================================================
# Activities → enable + URL Mapping → your deploy origin
# General Information → Interactions Endpoint:
#   https://<project-ref>.supabase.co/functions/v1/interactions-endpoint
# Install app into each pilot Discord server before publishing events
