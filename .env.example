# Copy to `.env` for local overrides (do not commit secrets).
# VITE_* variables are exposed to the client bundle.

# --- Discord Activity ---
# Application ID from Discord Developer Portal
VITE_DISCORD_CLIENT_ID=

# Optional: override Edge Functions base (defaults to VITE_SUPABASE_URL/functions/v1)
# VITE_API_BASE_URL=

# --- Supabase ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase Edge Function secrets (set via `supabase secrets set`) ---
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_PUBLIC_KEY=
# DISCORD_BOT_TOKEN=
# DISCORD_REDIRECT_URI=
# SUPABASE_SERVICE_ROLE_KEY=
# Public site URL for default cover images in Discord embeds (e.g. https://forza.events)
# APP_ORIGIN=

# --- Deploy (Vercel) ---
# Set the same VITE_* vars in the Vercel project settings.
