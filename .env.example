# FORZA.EVENTS — single local env file
#
# Setup:
#   cp .env.example .env
#   fill the REQUIRED values below (6 keys from 2 consoles)
#   npm run dev                          # Activity
#   npm run sync:secrets                 # push server secrets to Supabase
#
# Canonical names only — no need to duplicate VITE_* and server vars.
# Vite maps DISCORD_CLIENT_ID / SUPABASE_* into the client bundle automatically.
#
# Local browser dev: set DISCORD_REDIRECT_URI (see below), run npm run dev, Sign in on localhost.

# =============================================================================
# REQUIRED — Discord Developer Portal (one app)
# https://discord.com/developers/applications
# =============================================================================

# General Information → Application ID
DISCORD_CLIENT_ID=

# OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=

# General Information → Public Key (Interactions Endpoint verification)
DISCORD_PUBLIC_KEY=

# Bot → Token
DISCORD_BOT_TOKEN=

# =============================================================================
# REQUIRED — Supabase Dashboard → Project Settings → API
# https://supabase.com/dashboard
# =============================================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=

# =============================================================================
# OPTIONAL
# =============================================================================

# OAuth2 → Redirects — required for http://localhost:5180 (add same URL in Discord portal)
DISCORD_REDIRECT_URI=http://localhost:5180/auth/callback

# Default cover image origin in Discord embeds (defaults to https://forzaevents.up.railway.app)
# APP_ORIGIN=https://forzaevents.up.railway.app
# Edge CORS allowlist (comma-separated Supabase secret); APP_ORIGIN and *.discordsays.com are built-in.
# ALLOWED_CORS_ORIGINS=
# Extra OAuth redirect URIs for token-exchange (comma-separated Supabase secret).
# DISCORD_REDIRECT_URI_ALLOWLIST=
# Bot install uses callback-less OAuth from the Activity (no redirect env required).
# In Discord Developer Portal → Bot: disable "Requires OAuth2 Code Grant".

# Local Edge Function testing only — auto-injected when functions run on Supabase
# SUPABASE_SERVICE_ROLE_KEY=

# Override Edge Functions base (default: ${SUPABASE_URL}/functions/v1)
# VITE_API_BASE_URL=

# =============================================================================
# Railway + Railpack (recommended Activity hosting)
# =============================================================================
# New Project → Deploy from GitHub → builder: Railpack (railway.toml).
# Service → Variables (required at BUILD time for Vite — redeploy after changes):
#   DISCORD_CLIENT_ID
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   APP_ORIGIN=https://forzaevents.up.railway.app
# APP_ORIGIN is also used for Edge Function CORS (with Discord *.discordsays.com origins).
# Activity OAuth uses https://127.0.0.1 — not APP_ORIGIN. Bot install does not use APP_ORIGIN.
# CLI (after railway login && railway link):
#   railway variable set APP_ORIGIN=https://forzaevents.up.railway.app
# Public URL: https://forzaevents.up.railway.app
# Use it in Discord Activities URL Mapping. Do NOT set a custom start command.

# =============================================================================
# Discord portal (not env vars — configure once in Developer Portal)
# =============================================================================
# General Information → Terms of Service / Privacy Policy URLs:
#   https://<APP_ORIGIN>/terms
#   https://<APP_ORIGIN>/privacy
# Optional build-time contact for legal pages (default rudolfs@oas.lv):
# VITE_LEGAL_CONTACT_EMAIL=rudolfs@oas.lv
# Activities → enable + URL Mapping → your deploy origin
# General Information → Interactions Endpoint:
#   https://<project-ref>.supabase.co/functions/v1/interactions-endpoint
# Install app into each pilot Discord server before publishing events

# =============================================================================
# OPTIONAL — dev-only loading UX (Vite)
# =============================================================================
# Artificial delay before event list fetch (ms), e.g. 2000 to test spinners.
# VITE_DEV_LOADING_DELAY_MS=2000
