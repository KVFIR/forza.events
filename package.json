    "build:og": "node scripts/build-og-site-image.mjs",
    "seed:events": "node scripts/seed-events.mjs",
    "seed:cars": "node scripts/seed-cars.mjs",
    "data:fh5:scrape": "python3 scripts/scrape_fh5_fandom_cars.py",
    "data:fh5:catalog": "node scripts/build-fh5-app-catalog.mjs",
    "data:fh6:scrape": "python3 scripts/scrape_fh6_fandom_cars.py",
    "data:fh6:xlsx": "python3 scripts/build_fh6_fandom_xlsx.py",
    "data:fh6:catalog": "node scripts/build-fh6-app-catalog.mjs"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
