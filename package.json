{
  "name": "forza.events",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p supabase/functions",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "deploy:functions": "bash scripts/deploy-edge-functions.sh",
    "deploy:cf-worker": "wrangler deploy",
    "sync:secrets": "node scripts/sync-secrets.mjs",
